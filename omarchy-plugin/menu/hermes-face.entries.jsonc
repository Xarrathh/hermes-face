
  // ---- Hermes face (added by the pierregoosen.hermes-face plugin) ----
  "hermes": { "icon": "", "label": "Hermes face", "description": "The holographic agent head" },
  "hermes.open": { "label": "Open the face", "action": "~/.config/omarchy/plugins/pierregoosen.hermes-face/bin/face-focus.sh" },
  "hermes.stop": { "label": "Stop the turn", "action": "~/.config/omarchy/plugins/pierregoosen.hermes-face/bin/face-interrupt.sh" },
  "hermes.restart": { "label": "Restart the bridge", "action": "~/.config/omarchy/plugins/pierregoosen.hermes-face/bin/face-restart.sh" },
  "hermes.theme": {
    "label": "Theme sync",
    "action": "~/.config/omarchy/plugins/pierregoosen.hermes-face/bin/face-theme-toggle.sh",
    "checked": "! test -f ~/.local/share/hermes-face/theme-sync-off"
  },
  "hermes.edit": {
    "label": "Edit the look",
    "action": "HERMES_FACE_EDIT=1 ~/.config/omarchy/plugins/pierregoosen.hermes-face/bin/face-focus.sh"
  }
